# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=                    # From Supabase dashboard → Settings → API
SUPABASE_ANON_KEY=               # Public anon key (safe for frontend)
SUPABASE_SERVICE_ROLE_KEY=       # SECRET — server-side only, never in browser

# ── AI Providers (server-side only, never exposed to browser) ──
GEMINI_API_KEY=                  # aistudio.google.com — vision + reasoning
GROQ_API_KEY=                    # console.groq.com — course builder + content
DEEPSEEK_API_KEY=                # platform.deepseek.com — additional reasoning fallback

# ── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Vite exposes VITE_ prefix to frontend
VITE_SUPABASE_URL=               # Same as SUPABASE_URL
VITE_SUPABASE_ANON_KEY=          # Same as SUPABASE_ANON_KEY
