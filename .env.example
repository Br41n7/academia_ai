# ── AI Providers (server-side — never exposed to browser) ──
GEMINI_API_KEY=             # Required. Get from aistudio.google.com
DEEPSEEK_API_KEY=           # Optional. deepseek.com/api
ANTHROPIC_API_KEY=          # Optional. console.anthropic.com
OPENAI_API_KEY=             # Optional. platform.openai.com

# ── Firebase Admin ──
# Paste the full service account JSON as a single-line string.
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── App ──
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173   # Set to your Render URL in prod

# ── Firebase client config ──
# NOT set via env vars — configured in firebase-applet-config.json
# at the project root. Edit that file directly.
