{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-server",
    "rootDir": "./",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "allowImportingTsExtensions": false,
    "noEmit": false
  },
  "include": ["server.ts", "server/**/*.ts"],
  "exclude": ["src", "dist", "dist-server", "node_modules"]
}
